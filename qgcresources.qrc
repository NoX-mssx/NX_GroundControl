        <file alias="Satellite.svg">resources/Satellite.svg</file>
        <file alias="nx/Camera.svg">resources/nx/Camera.svg</file>
        <file alias="nx/ChevronDown.svg">resources/nx/ChevronDown.svg</file>
        <file alias="nx/Disconnect.svg">resources/nx/Disconnect.svg</file>
        <file alias="nx/Gear.svg">resources/nx/Gear.svg</file>
        <file alias="nx/Home.svg">resources/nx/Home.svg</file>
        <file alias="nx/LockClosed.svg">resources/nx/LockClosed.svg</file>
